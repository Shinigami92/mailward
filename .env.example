# mailward needs little or no .env: accounts live in accounts.yaml and per-vendor connection
# defaults (IMAP host/port, OAuth client/authority/scope) come from the code vendor registry,
# overridable per account in accounts.yaml. Values here are validated at startup (envalid).

# Root directory for per-account OAuth token caches (one <id>/ subdir per account, e.g.
# .cache/personal/msal.json). Override to mount it as a volume in Docker so logins persist.
# CACHE_DIR=.cache

# Set to 1/true to log MSAL's auth/token traffic when debugging Microsoft sign-in.
# MSAL_DEBUG=0

# Per-account secrets (password / app-password vendors): an account in accounts.yaml names the
# env var via `passwordEnv: <NAME>`, and you put the value here. Example:
# WORK_GMAIL_PASSWORD=your-app-password
