# Everything has sensible defaults — you normally do NOT need a .env file at all.
# These are only for overriding (e.g. if you register your own Entra app one day).
# Values are validated at startup (envalid); an invalid value fails fast.

# OAuth client ID. Defaults to Mozilla Thunderbird's public client ID, which works
# with personal Outlook/Hotmail accounts without you registering anything.
# CLIENT_ID=9e5f94bc-e8a4-4e73-b8be-63364c29d753

# OAuth authority. Must be "common" for the borrowed client to accept a personal account.
# AUTHORITY=https://login.microsoftonline.com/common

# OAuth redirect URI. Must match the one registered for CLIENT_ID. The default works
# for the borrowed Thunderbird client (we just paste back the localhost redirect URL).
# REDIRECT_URI=https://localhost

# Where the MSAL token cache (refresh token) is stored. Override to mount it in Docker.
# Default: <project>/.cache/msal.json
# TOKEN_CACHE_PATH=/data/msal.json

# IMAP server. Defaults target personal Outlook/Hotmail; override for another provider.
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993

# Set to 1/true to log MSAL's auth/token traffic when debugging sign-in.
# MSAL_DEBUG=0

# Folder selection (scan/ignore/confidential) now lives in config.yaml, not here.
