{
  "name": "mailward-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Rule-driven inbox auto-triage over IMAP, configured from a web UI - a \"Pi-hole for your email\".",
  "license": "MIT",
  "author": {
    "name": "Christopher Quadflieg",
    "email": "chrissi92@hotmail.de",
    "url": "https://github.com/Shinigami92"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "cargo watch --watch crates --exec \"run -p mailward-api\"",
    "dev:web": "pnpm --filter @mailward/web dev",
    "format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore .",
    "lint": "oxlint"
  },
  "devDependencies": {
    "concurrently": "10.0.3",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "oxlint-tsgolint": "0.23.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.5.2"
}
