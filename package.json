{
  "name": "mailward",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Rule-driven inbox auto-triage over IMAP (mark-read / delete) — a \"Pi-hole for your email\". Outlook/Hotmail supported first.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/msal-node": "5.2.2",
    "envalid": "8.1.1",
    "imapflow": "1.3.5",
    "mailparser": "3.9.9",
    "parse-duration": "2.1.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/mailparser": "3.4.6",
    "@types/node": "25.9.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.3.0"
}
